#!/usr/bin/env python3
"""Fake herdr CLI: serves state from $FAKE_HERDR_STATE and logs every call to $FAKE_HERDR_LOG."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_HERDR_LOG"], "a") as f:
    f.write(json.dumps(args) + "\n")
state = json.load(open(os.environ["FAKE_HERDR_STATE"]))


def ok(result):
    print(json.dumps({"id": "fake", "result": result}))
    sys.exit(0)


head = args[:2]
if head == ["agent", "list"]:
    ok({"agents": state.get("agents", [])})
if head == ["workspace", "list"]:
    ok({"workspaces": state.get("workspaces", [])})
if head == ["pane", "list"]:
    ok({"panes": state.get("panes", [])})
if head == ["pane", "layout"]:
    ok({"layout": state["layout"]})
if head == ["pane", "split"]:
    ok({"pane": {"pane_id": "NEW_PANE"}})
if head == ["workspace", "create"]:
    ok({"workspace": {"workspace_id": "NEW_WS"}, "tab": {"tab_id": "NEW_WS:t1"},
        "root_pane": {"pane_id": "NEW_WS:p1"}})
if head == ["pane", "read"]:
    print("prompt %")
    sys.exit(0)
if head == ["pane", "get"]:
    sys.exit(1)  # the overlay is already gone
ok({})
